# ─────────────────────────────────────────────────────────────
# Deploy-only variables (VPS). These are NOT part of the site bundle.
# Append these to the same ".env" file you create from .env.example.
# ─────────────────────────────────────────────────────────────

# Loopback port the container publishes on the VPS.
# Only 127.0.0.1 binds to it, so it is not reachable from the internet —
# your reverse proxy forwards to it. Change it if 8087 is already taken.
# Check first with:  ss -ltnp | grep 8087
HOST_PORT=8087
